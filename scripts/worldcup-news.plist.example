<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for the WC-2026 team-news refresh.

  INSTALL
    1. Copy this file to ~/Library/LaunchAgents/com.worldcup2026.teamnews.plist
    2. Replace every /ABSOLUTE/PATH/TO/REPO below with your checkout path
       (launchd does not expand ~ or environment variables).
    3. Put your key in ~/.worldcup2026.env -- NEVER in this file or the repo:
           export ANTHROPIC_API_KEY="sk-ant-..."
       Without it the script logs a SKIP and makes zero API calls.
    4. Load it:
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.worldcup2026.teamnews.plist
           launchctl list | grep worldcup2026        # confirm it is loaded
    5. Unload / disable:
           launchctl bootout gui/$(id -u)/com.worldcup2026.teamnews

  Runs every 2 days (StartInterval 172800). Invoked with /bin/bash so the
  script's `#!/usr/bin/env bash` shebang and `set -euo pipefail` are honoured.
  Application logs: <repo>/data/team_news_refresh.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.worldcup2026.teamnews</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/ABSOLUTE/PATH/TO/REPO/scripts/refresh_team_news.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>172800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/REPO/data/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/REPO/data/launchd.err.log</string>
</dict>
</plist>
